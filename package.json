{
  "name": "dsh-attention-reminder",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Sound and popup alerts when DSH needs your approval or a confirmation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenyuiyu/dsh-attention-reminder.git"
  },
  "homepage": "https://github.com/chenyuiyu/dsh-attention-reminder#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "notification",
    "approval",
    "alert"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
